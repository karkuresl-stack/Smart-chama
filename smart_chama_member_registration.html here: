
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Smart Chama - Member Registration</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}body{margin:0;background:#f1f5f9;color:#243247;font:16px Arial,sans-serif}
header{background:#103d30;color:white;padding:22px}main{max-width:720px;margin:22px auto;padding:14px}
.card{background:white;border-radius:16px;padding:20px;margin-bottom:18px}
h1{margin:0 0 8px}label{display:block;font-weight:bold;margin:16px 0 8px}
select{width:100%;padding:14px;border:1px solid #ccd5d1;border-radius:10px;font-size:16px}
button,a{display:inline-block;padding:13px 16px;border:0;border-radius:10px;background:#17654c;color:white;text-decoration:none;font-weight:bold;margin:8px 6px 0 0;cursor:pointer}
.secondary{background:#e8f1ec;color:#103d30} .notice{padding:14px;background:#eaf4ee;border-radius:10px;overflow-wrap:anywhere}
.error{background:#ffeded;color:#8c1d1d}.muted{color:#667085;line-height:1.5}
button:disabled{opacity:.5}
</style>
</head>
<body>
<header><h1>Smart Chama</h1><p>Member Registration</p></header>
<main>
<section class="card">
<h2>Account</h2>
<div id="status" class="notice">Connecting securely...</div>
<a class="secondary" href="smart_chama_supabase_ready-2.html">Member Access / Sign in</a>
<a class="secondary" href="smart_chama_main.html">Main System</a>
</section>
<section class="card">
<h2>Request membership</h2>
<p class="muted">Choose a chama and submit your request. You can use group services after your membership is approved.</p>
<label for="group">Choose chama</label>
<select id="group" disabled><option>Loading groups...</option></select>
<button id="submit" disabled onclick="submitRequest()">Submit membership request</button>
<div id="result" class="notice" hidden></div>
</section>
</main>
<script>
const URL="https://kbrhjgnwbkszmjldbfor.supabase.co";
const KEY="sb_publishable__Tck9HRnjrqdLdbpH36YPQ_-7vpek8B";
const db=supabase.createClient(URL,KEY);
const $=id=>document.getElementById(id);
let currentUser=null;

function status(text,error=false){
 $("status").textContent=text;
 $("status").className="notice"+(error?" error":"");
}
function result(text,error=false){
 $("result").hidden=false;
 $("result").textContent=text;
 $("result").className="notice"+(error?" error":"");
}
function timeout(promise,ms,label){
 return Promise.race([promise,new Promise((_,reject)=>setTimeout(()=>reject(new Error(label+" timed out. Refresh the page and sign in again.")),ms))]);
}
async function init(){
 try{
  const {data,error}=await timeout(db.auth.getSession(),12000,"Sign-in check");
  if(error)throw error;
  currentUser=data.session?.user;
  if(!currentUser){
   status("You are not signed in. Tap Member Access / Sign in, sign in, then return here.",true);
   return;
  }
  status("Signed in as "+currentUser.email);
  const {data:groups,error:groupError}=await timeout(
   db.from("chama_groups").select("id,name,description").order("name"),
   12000,"Group loading");
  if(groupError)throw groupError;
  const select=$("group");
  select.innerHTML="";
  if(!groups?.length){
   select.innerHTML="<option value=''>No groups available</option>";
   result("No chama groups are available yet.",true);
   return;
  }
  for(const g of groups){
   const option=document.createElement("option");
   option.value=g.id;
   option.textContent=g.name+(g.description?" — "+g.description:"");
   select.appendChild(option);
  }
  select.disabled=false;
  $("submit").disabled=false;
 }catch(e){status("Registration could not load: "+e.message,true);}
}
async function submitRequest(){
 if(!currentUser){result("Sign in first.",true);return;}
 const groupId=$("group").value;
 if(!groupId){result("Choose a chama first.",true);return;}
 $("submit").disabled=true;
 try{
  const {data,error}=await timeout(db.rpc("request_chama_membership",{p_group_id:groupId}),15000,"Membership request");
  if(error)throw error;
  result(data||"Request submitted. Await approval.");
 }catch(e){result("Request failed: "+e.message,true);}
 finally{$("submit").disabled=false;}
}
init();
</script>
</body>
</html>
